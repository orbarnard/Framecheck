{
  "id": "meta_feed",
  "name": "Meta Feed",
  "category": "social",
  "description": "Facebook and Instagram in-feed video: 4:5 portrait, 1080x1350.",
  "filename_tag": "META-FEED",
  "source_url": "https://www.facebook.com/business/ads-guide/video",
  "notes": [
    "4:5 takes the most feed real estate without being cropped to square on any surface.",
    "Assume the sound is off: anything essential must be legible without audio."
  ],
  "requirements": {
    "container": {
      "equals": "mp4",
      "severity": "fail",
      "fixable": true
    },
    "video.codec": {
      "equals": "h264",
      "severity": "fail",
      "fixable": true
    },
    "video.resolution": {
      "equals": "1080x1350",
      "severity": "fail",
      "fixable": true
    },
    "video.aspect_ratio": {
      "equals": "4:5",
      "severity": "fail",
      "fixable": false
    },
    "video.frame_rate": {
      "max": 30,
      "severity": "fail",
      "fixable": true
    },
    "video.scan_type": {
      "equals": "progressive",
      "severity": "fail",
      "fixable": true
    },
    "video.pixel_format": {
      "equals": "yuv420p",
      "severity": "warning",
      "fixable": true
    },
    "audio.codec": {
      "equals": "aac",
      "severity": "fail",
      "fixable": true
    },
    "audio.channels": {
      "equals": 2,
      "severity": "warning",
      "fixable": true
    },
    "audio.sample_rate_hz": {
      "preferred": 48000,
      "severity": "warning",
      "fixable": true
    },
    "audio.bitrate_kbps": {
      "min": 128,
      "preferred": 192,
      "severity": "warning",
      "fixable": true
    },
    "review.safe_zones": {
      "manual": true,
      "label": "Text and logo safe zones",
      "guidance": "Confirm nothing important sits where the feed UI overlays the frame, top and bottom."
    },
    "review.sound_off": {
      "manual": true,
      "label": "Sound-off legibility",
      "guidance": "Confirm the message reads with the sound muted: captions, on-screen text or clear visuals."
    }
  },
  "target": {
    "container": "mp4",
    "output_extension": ".mp4",
    "video_codec": "h264",
    "video_profile": "high",
    "pixel_format": "yuv420p",
    "width": 1080,
    "height": 1350,
    "aspect_ratio": "4:5",
    "frame_rate_behavior": "preserve_native_if_allowed",
    "allowed_frame_rates": [
      23.976,
      24,
      25,
      29.97,
      30
    ],
    "preferred_frame_rate": 30,
    "constant_frame_rate": true,
    "video_bitrate_mbps": 8,
    "video_bitrate_max_mbps": 12,
    "audio": {
      "codec": "aac",
      "channels": 2,
      "sample_rate_hz": 48000,
      "bitrate_kbps": 192
    },
    "faststart": true
  }
}
