{
  "id": "meta_instream",
  "name": "Meta In-Stream",
  "category": "social",
  "description": "Facebook in-stream video ads: landscape 16:9, 1920x1080.",
  "filename_tag": "META-IS",
  "source_url": "https://www.facebook.com/business/ads-guide/video",
  "notes": [
    "In-stream is the one Meta placement that stays landscape, so a CTV or online master usually serves it unchanged.",
    "Sound is generally on for in-stream, unlike feed and Reels."
  ],
  "requirements": {
    "container": {
      "equals": "mp4",
      "severity": "fail",
      "fixable": true
    },
    "video.codec": {
      "equals": "h264",
      "severity": "fail",
      "fixable": true
    },
    "video.resolution": {
      "equals": "1920x1080",
      "severity": "fail",
      "fixable": true
    },
    "video.aspect_ratio": {
      "equals": "16:9",
      "severity": "fail",
      "fixable": false
    },
    "video.frame_rate": {
      "max": 30,
      "severity": "fail",
      "fixable": true
    },
    "video.scan_type": {
      "equals": "progressive",
      "severity": "fail",
      "fixable": true
    },
    "video.pixel_format": {
      "equals": "yuv420p",
      "severity": "warning",
      "fixable": true
    },
    "audio.codec": {
      "equals": "aac",
      "severity": "fail",
      "fixable": true
    },
    "audio.channels": {
      "equals": 2,
      "severity": "warning",
      "fixable": true
    },
    "audio.sample_rate_hz": {
      "preferred": 48000,
      "severity": "warning",
      "fixable": true
    },
    "audio.bitrate_kbps": {
      "min": 128,
      "preferred": 192,
      "severity": "warning",
      "fixable": true
    },
    "review.disclaimer": {
      "manual": true,
      "label": "Legal disclaimer",
      "guidance": "Confirm any required disclaimer is present and legible on a phone-sized player."
    }
  },
  "target": {
    "container": "mp4",
    "output_extension": ".mp4",
    "video_codec": "h264",
    "video_profile": "high",
    "pixel_format": "yuv420p",
    "width": 1920,
    "height": 1080,
    "aspect_ratio": "16:9",
    "frame_rate_behavior": "preserve_native_if_allowed",
    "allowed_frame_rates": [
      23.976,
      24,
      25,
      29.97,
      30
    ],
    "preferred_frame_rate": 30,
    "constant_frame_rate": true,
    "video_bitrate_mbps": 10,
    "video_bitrate_max_mbps": 16,
    "audio": {
      "codec": "aac",
      "channels": 2,
      "sample_rate_hz": 48000,
      "bitrate_kbps": 192
    },
    "faststart": true
  }
}
