{
  "id": "online_video",
  "name": "Online Video",
  "category": "video",
  "description": "General web and programmatic video delivery: landscape HD, modest file size, fast start.",
  "filename_tag": "OLV",
  "notes": [
    "Many ad servers cap the creative at 150 MB and silently reject anything larger.",
    "Faststart matters here more than anywhere else: without it the player buffers the whole file before the first frame."
  ],
  "requirements": {
    "container": {
      "equals": "mp4",
      "severity": "fail",
      "fixable": true
    },
    "video.codec": {
      "equals": "h264",
      "severity": "fail",
      "fixable": true
    },
    "video.resolution": {
      "allowed": [
        "1920x1080",
        "1280x720"
      ],
      "severity": "fail",
      "fixable": true
    },
    "video.aspect_ratio": {
      "preferred": "16:9",
      "severity": "warning",
      "fixable": false
    },
    "video.frame_rate": {
      "allowed": [
        23.976,
        24,
        25,
        29.97,
        30
      ],
      "severity": "fail",
      "fixable": true
    },
    "video.scan_type": {
      "equals": "progressive",
      "severity": "fail",
      "fixable": true
    },
    "video.pixel_format": {
      "equals": "yuv420p",
      "severity": "warning",
      "fixable": true
    },
    "video.bitrate_mbps": {
      "min": 4,
      "max": 12,
      "preferred": 8,
      "severity": "warning",
      "fixable": true
    },
    "audio.codec": {
      "equals": "aac",
      "severity": "fail",
      "fixable": true
    },
    "audio.channels": {
      "equals": 2,
      "severity": "warning",
      "fixable": true
    },
    "audio.sample_rate_hz": {
      "equals": 48000,
      "severity": "warning",
      "fixable": true
    },
    "audio.bitrate_kbps": {
      "min": 192,
      "preferred": 256,
      "severity": "warning",
      "fixable": true
    },
    "file.size_mb": {
      "max": 150,
      "severity": "warning",
      "fixable": true
    },
    "review.disclaimer": {
      "manual": true,
      "label": "Legal disclaimer",
      "guidance": "Confirm any required disclaimer is present and legible at the size the placement actually plays."
    }
  },
  "target": {
    "container": "mp4",
    "output_extension": ".mp4",
    "video_codec": "h264",
    "video_profile": "high",
    "pixel_format": "yuv420p",
    "width": 1920,
    "height": 1080,
    "aspect_ratio": "16:9",
    "frame_rate_behavior": "preserve_native_if_allowed",
    "allowed_frame_rates": [
      23.976,
      24,
      25,
      29.97,
      30
    ],
    "preferred_frame_rate": 25,
    "constant_frame_rate": true,
    "video_bitrate_mbps": 8,
    "video_bitrate_max_mbps": 12,
    "audio": {
      "codec": "aac",
      "channels": 2,
      "sample_rate_hz": 48000,
      "bitrate_kbps": 256,
      "loudness_lkfs": -16,
      "true_peak_db": -1.0
    },
    "faststart": true
  }
}
